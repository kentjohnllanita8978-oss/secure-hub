# ── Mobile API Configuration ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Set EXPO_PUBLIC_API_URL to YOUR machine's local IP address.
#
# How to find your LAN IP:
#   Windows  → open Terminal/CMD, run: ipconfig
#              look for "IPv4 Address" under your Wi-Fi adapter
#   macOS    → open Terminal, run: ifconfig | grep "inet "
#
# Examples:
#   Physical device / Expo Go → http://192.168.x.x:8000/api
#   Android Emulator           → http://10.0.2.2:8000/api
#   iOS Simulator / Web        → http://127.0.0.1:8000/api
#
# ⚠️  Your phone must be on the SAME Wi-Fi network as your PC.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8000/api

# ── Reverb WebSocket (real-time sync) ────────────────────────────────────
# Must match REVERB_APP_KEY and REVERB_HOST in the Laravel .env.
# Replace YOUR_LAN_IP with the same IP as above.
EXPO_PUBLIC_REVERB_APP_KEY=securets-key
EXPO_PUBLIC_REVERB_HOST=YOUR_LAN_IP
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
