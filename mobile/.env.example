# ── Mobile API Configuration ─────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
# Examples:
#   Local dev (physical device / Expo Go) → http://192.168.x.x:8000/api
#   Android Emulator                       → http://10.0.2.2:8000/api
#   iOS Simulator / Web                    → http://127.0.0.1:8000/api
#   Production (Railway)                   → https://your-app.up.railway.app/api
EXPO_PUBLIC_API_URL=https://your-app.up.railway.app/api

# ── Reverb WebSocket (real-time sync) ────────────────────────────────────
# Must match REVERB_APP_KEY and REVERB_HOST in the Laravel .env.
# Production (Railway): use your Railway domain, scheme=https, port=443
EXPO_PUBLIC_REVERB_APP_KEY=securets-key
EXPO_PUBLIC_REVERB_HOST=your-app.up.railway.app
EXPO_PUBLIC_REVERB_PORT=443
EXPO_PUBLIC_REVERB_SCHEME=https
